# Copy to .env and fill in. .env is gitignored.

# --- embeddings -------------------------------------------------------------
# local  = sentence-transformers, runs offline, no key. The default, and what
#          makes the retrieval evaluation reproducible by anyone.
# hash   = non-semantic, instant, for tests and CI only.
# voyage / openai = hosted, better quality, needs a key.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- generation -------------------------------------------------------------
# Optional. Without it /query still retrieves; it just won't write an answer.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
MAX_ANSWER_TOKENS=1024

# --- chunking ---------------------------------------------------------------
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- retrieval --------------------------------------------------------------
# Candidates fetched per retriever before fusion. Must exceed TOP_K: fusion can
# only reorder what it is given.
CANDIDATE_K=30
TOP_K=8
RRF_K=60
# Refuse to generate when the best retrieval score is below this. 0 disables.
MIN_RETRIEVAL_SCORE=0.0

MAX_CONTEXT_CHARS=12000

# --- storage ----------------------------------------------------------------
STORE=memory
DATABASE_URL=postgresql://engine:engine@localhost:5432/engine

# --- ingestion --------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
MAX_CONCURRENT_INGESTIONS=2
EMBED_BATCH_SIZE=64

LOG_LEVEL=INFO
